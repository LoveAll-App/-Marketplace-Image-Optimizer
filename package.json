{
  "name": "marketplace-image-optimizer",
  "version": "1.0.0",
  "private": true,
  "description": "One Product Photo → Marketplace Ready Everywhere. Local-first image optimizer for Amazon India, Flipkart and Meesho.",
  "type": "module",
  "workspaces": ["packages/*", "apps/web", "apps/server", "apps/cli"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @moi/server\" \"npm run dev -w @moi/web\"",
    "build": "npm run build -w @moi/web",
    "start": "npm run start -w @moi/server",
    "cli": "node apps/cli/bin/marketplace-optimizer.mjs",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/archiver": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
